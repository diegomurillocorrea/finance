# Copia a .env.local o .env (no subas secretos al repositorio)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Una de las dos (según lo que muestre tu proyecto en Settings → API):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# o clave publishable nueva:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Recomendado en este panel (solo servidor, NUNCA en el cliente):
# Evita errores RLS si las políticas no aplican bien al JWT. Tras validar login,
# el backend usa esta clave para leer/escribir tablas.
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret
#
# Alternativa: ejecuta en Supabase SQL Editor:
# supabase/migrations/20260328120000_rls_authenticated_explicit.sql
